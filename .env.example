# Authentik core secrets
# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# PostgreSQL credentials (must match what postgres container uses)
AUTHENTIK_POSTGRESQL__PASSWORD=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__NAME=authentik

# Bootstrap credentials used only on first run to create the initial admin account.
# Remove or leave blank after first start.
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-bootstrap-admin-password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
# A long-lived API token pre-seeded into authentik for scripts/setup-authentik.sh.
# Generate any random string; authentik will register it on first boot.
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-bootstrap-api-token

# Backend configuration
# The URL the Rust backend uses to reach authentik (inside docker network or localhost)
AUTHENTIK_BASE_URL=http://localhost:9000
# Filled in by scripts/setup-authentik.sh after first run
AUTHENTIK_API_TOKEN=
# The authentik OIDC application slug configured for this UI
AUTHENTIK_OIDC_SLUG=roleui
# Port the Rust backend listens on
BACKEND_PORT=8080
