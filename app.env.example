# Runtime — read by the backend at startup
AUTHENTIK_BASE_URL=https://auth.example.com
AUTHENTIK_API_TOKEN=

# Optional runtime vars (defaults shown)
BACKEND_PORT=8080
AUDIT_LOG_PATH=/app/audit.log

# Build-time — baked into the JS bundle by Vite; changing these requires a rebuild
VITE_AUTHENTIK_BASE_URL=https://auth.example.com
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=https://app.example.com/auth/callback
VITE_OIDC_SLUG=roleui
VITE_BACKEND_URL=
