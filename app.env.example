# Runtime — read by the backend at startup
AUTHENTIK_BASE_URL=https://auth.example.com
AUTHENTIK_API_TOKEN=

# OIDC — injected into index.html at runtime; no rebuild needed when these change
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://app.example.com/auth/callback

# Optional runtime vars (defaults shown)
BACKEND_PORT=8080
AUDIT_LOG_PATH=/app/audit.log

# Local dev only (Vite dev server; not used when running via Docker)
VITE_AUTHENTIK_BASE_URL=https://auth.example.com
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=https://app.example.com/auth/callback
